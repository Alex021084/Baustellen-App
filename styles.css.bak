*{box-sizing:border-box}body{margin:0;background:#f2f2f7;color:#111;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;padding-bottom:80px}header{position:sticky;top:0;z-index:5;background:#fff;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ddd}header small{color:#777}h1{font-size:25px;margin:2px 0}header button{border:0;border-radius:50%;background:#0a84ff;color:#fff;width:42px;height:42px;font-size:25px}.screen{display:none;max-width:760px;margin:auto;padding:16px}.active{display:block}.primary{background:#0a84ff;color:#fff;border:0;border-radius:12px;padding:14px;font-weight:700;font-size:16px}.big{width:100%;margin-bottom:14px}.cards{display:grid;gap:10px}.card{background:#fff;border:0;border-radius:15px;padding:17px;display:flex;align-items:center;gap:12px;text-align:left;font-size:20px}.card span{flex:1;font-size:15px}.card small{display:block;color:#777;margin-top:3px}.panel{background:#fff;border-radius:15px;padding:15px;margin-bottom:13px}h2{font-size:18px;margin:0 0 12px}.title{display:flex;align-items:center;gap:10px}.title h2{flex:1}label{display:block;color:#666;font-size:13px;margin:10px 0}input,textarea{width:100%;margin-top:5px;padding:11px;border:1px solid #d5d5da;border-radius:10px;font:inherit;background:#fafafa}textarea{min-height:70px}.title button,#addWork,#addMat,#homeBtn,#clear{border:1px solid #ccc;background:#fff;border-radius:10px;padding:9px;font-weight:600}.employee{border:1px solid #ddd;border-radius:12px;padding:10px;margin:8px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.grid3{grid-template-columns:1fr 1fr 1fr}.del{float:right;border:0;background:#fff0f0;color:#c00;border-radius:7px;padding:5px}.item{display:flex;gap:7px;margin:7px 0}.item input{margin:0}.item button{width:42px}.steps{font-size:12px;color:#0a84ff;background:#e8f2ff;border-radius:10px;padding:9px;margin-bottom:12px;white-space:nowrap;overflow:hidden}.row{display:flex;gap:8px;margin-top:9px}canvas{width:100%;height:180px;border:1px solid #ddd;border-radius:12px;touch-action:none}.actions{display:grid;gap:9px}.archive{background:#fff;border-radius:13px;padding:14px;margin:8px 0}.archive small{display:block;color:#777}nav{position:fixed;bottom:0;left:0;right:0;height:70px;background:#fff;border-top:1px solid #ddd;display:flex;justify-content:space-around;padding-bottom:env(safe-area-inset-bottom);z-index:8}nav button{border:0;background:none;font-size:22px;color:#777}nav small{display:block;font-size:11px}.titleBtn{border:1px solid #ccc;background:#fff;border-radius:10px;padding:9px 12px;font-weight:600;margin:0 0 6px}
select{width:100%;margin-top:5px;padding:11px;border:1px solid #d5d5da;border-radius:10px;font:inherit;background:#fafafa}
.customerDel{margin-top:8px}

.serviceRow{display:flex;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid #eee}
.serviceRow:last-child{border-bottom:0}
.serviceRow input{margin:0;flex:1;background:#fff}
.serviceActions{display:flex;gap:6px}
.serviceActions button{border:1px solid #ccc;background:#fff;border-radius:9px;padding:8px;font-weight:600}
.serviceActions .serviceDel{background:#fff0f0;color:#c00}
.empty{color:#777;padding:8px 0}
@media(max-width:520px){.serviceRow{align-items:stretch;flex-direction:column}.serviceActions{display:grid;grid-template-columns:1fr 1fr}.serviceActions button{width:100%}}

.hint{color:#666;font-size:14px;line-height:1.45;margin:0 0 12px}.signatureStatus{margin-top:10px;padding:10px 12px;border-radius:10px;background:#f2f2f7;color:#666;font-size:13px}.signatureStatus.signed{background:#eaf7ee;color:#19723a;font-weight:600}
.summaryContent{margin-top:10px}.summaryBlock{border:1px solid #e1e1e5;border-radius:13px;padding:12px;margin:9px 0;background:#fff}.summaryBlock h3{font-size:15px;margin:0 0 8px}.summaryMeta{display:grid;grid-template-columns:1fr 1fr;gap:7px;font-size:14px}.summaryMeta div{background:#f7f7f9;border-radius:9px;padding:8px}.summaryMeta b{display:block;font-size:11px;color:#777;margin-bottom:2px}.summaryTable{width:100%;border-collapse:collapse;font-size:13px}.summaryTable th,.summaryTable td{text-align:left;padding:8px 5px;border-bottom:1px solid #eee;vertical-align:top}.summaryTable th{font-size:11px;color:#777}.summaryList{margin:0;padding-left:20px}.summaryTotal{font-weight:700;margin-top:9px}.signatureActions{margin-top:12px}
@media(max-width:520px){.summaryMeta{grid-template-columns:1fr}.summaryTable{font-size:12px}.summaryTable th,.summaryTable td{padding:7px 3px}}

.confirmSignature{background:#28a745;color:#fff;border:0;border-radius:50%;width:64px;height:64px;font-size:34px;font-weight:800;justify-self:end;box-shadow:0 3px 8px rgba(0,0,0,.18)}.confirmSignature:disabled{opacity:.6}

.archiveFolder{background:#fff;border:1px solid #e1e1e6;border-radius:16px;margin:12px 0;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,.04)}
.archiveFolder>summary{list-style:none;display:flex;align-items:center;gap:12px;padding:16px;cursor:pointer;background:#fff}
.archiveFolder>summary::-webkit-details-marker,.projectFolder>summary::-webkit-details-marker{display:none}
.folderIcon{width:36px;height:36px;border-radius:10px;background:#fff4d6;display:grid;place-items:center;font-size:20px;flex:0 0 36px}
.folderInfo,.projectInfo{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}
.folderInfo b{font-size:16px;line-height:1.25;overflow-wrap:anywhere}
.folderInfo small,.projectInfo small{font-size:12px;color:#777}
.folderChevron,.projectChevron{font-size:22px;color:#888;line-height:1;transition:transform .15s ease}
.archiveFolder[open]>summary .folderChevron,.projectFolder[open]>summary .projectChevron{transform:rotate(180deg)}
.projectList{padding:0 10px 10px;background:#fafafd}
.projectFolder{border:1px solid #e3e3e8;border-radius:13px;overflow:hidden;margin:10px 0;background:#fff}
.projectFolder>summary{list-style:none;display:flex;align-items:center;gap:10px;padding:13px 12px;cursor:pointer}
.projectIcon{width:28px;height:28px;border-radius:8px;background:#eef5ff;color:#0a84ff;display:grid;place-items:center;font-size:13px;flex:0 0 28px}
.projectInfo b{font-size:14px;line-height:1.3;overflow-wrap:anywhere}
.archiveItems{border-top:1px solid #eee}
.archiveItem{display:flex;align-items:center;gap:9px;padding:12px;border-top:1px solid #f0f0f2;background:#fff}
.archiveItem:first-child{border-top:0}
.archiveDate{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}
.archiveDate b{font-size:14px;line-height:1.25}
.archiveDate small{font-size:11px;color:#777}
.statusBadge{flex:0 0 auto;border-radius:999px;padding:5px 8px;font-size:10px;font-weight:700;white-space:nowrap}
.statusBadge.signed{background:#eaf7ee;color:#19723a}
.statusBadge.draft{background:#f1f1f5;color:#666}
.archiveItem button{border:1px solid #d4d4da;background:#fff;border-radius:9px;padding:8px 11px;font-weight:600;white-space:nowrap}
.emptyState{text-align:center;padding:28px 18px}.emptyState .emptyIcon{font-size:30px;color:#999;margin-bottom:8px}.emptyState b{display:block;font-size:16px}.emptyState small{display:block;color:#777;margin-top:4px}
@media(max-width:520px){
  .archiveFolder>summary{padding:14px}
  .projectList{padding:0 8px 8px}
  .archiveItem{padding:11px 9px;flex-wrap:wrap}
  .archiveDate{flex-basis:calc(100% - 48px)}
  .statusBadge{margin-left:37px}
  .archiveItem button{margin-left:auto}
}

/* Überarbeitete Nachweis-Übersicht */
.archiveFolderCard{background:#fff;border:1px solid #dedee3;border-radius:18px;margin:12px 0;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.archiveFolderHead,.projectHead{width:100%;border:0;background:#fff;text-align:left;display:flex;align-items:center;gap:12px;cursor:pointer;font:inherit}
.archiveFolderHead{padding:15px 14px}
.folderIconBig,.projectIconBig{display:grid;place-items:center;flex:0 0 auto;border-radius:11px}
.folderIconBig{width:40px;height:40px;background:#fff3cf;font-size:22px}
.folderTitle,.projectTitle{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}
.folderTitle strong{font-size:17px;line-height:1.2;overflow-wrap:anywhere}
.folderTitle small,.projectTitle small{font-size:12px;color:#777}
.folderArrow,.projectArrow{font-size:20px;color:#777;width:24px;text-align:center}
.archiveFolderBody{background:#f7f7fa;border-top:1px solid #ececf0;padding:8px}
.projectCard{background:#fff;border:1px solid #e1e1e6;border-radius:14px;overflow:hidden;margin:8px 0}
.projectHead{padding:12px}
.projectIconBig{width:32px;height:32px;background:#eaf2ff;color:#0a84ff;font-size:15px}
.projectTitle strong{font-size:14px;line-height:1.3;overflow-wrap:anywhere}
.projectBody{border-top:1px solid #eee}
.reportRow{display:flex;align-items:center;gap:10px;padding:11px 12px;border-top:1px solid #f0f0f2;background:#fff}
.reportRow:first-child{border-top:0}
.reportMain{min-width:0;flex:1;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.reportMain strong{font-size:14px}
.reportStatus{font-size:11px;font-weight:700;border-radius:999px;padding:5px 8px;white-space:nowrap}
.reportStatus.isSigned{background:#e9f7ed;color:#19723a}
.reportStatus.isDraft{background:#f0f0f4;color:#666}
.openReport{border:1px solid #d5d5da;background:#fff;border-radius:9px;padding:8px 12px;font-weight:600;white-space:nowrap}
@media(max-width:520px){.archiveFolderHead{padding:14px 12px}.reportRow{padding:10px}.reportMain{gap:6px}.reportMain strong{font-size:13px}.openReport{padding:7px 10px}}

/* Nachweis-Archiv: klare Hierarchie Auftraggeber → Baustelle → Nachweis */
.archiveFolderCard{background:#fff;border:1px solid #dedee3;border-radius:18px;margin:12px 0;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.archiveFolderHead,.projectHead{width:100%;border:0;background:#fff;text-align:left;display:flex;align-items:center;gap:12px;cursor:pointer;font:inherit}
.archiveFolderHead{padding:15px 14px}.folderIconBig,.projectIconBig{display:grid;place-items:center;flex:0 0 auto;border-radius:11px}
.folderIconBig{width:40px;height:40px;background:#fff3cf;font-size:22px}.folderTitle,.projectTitle{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}
.folderTitle strong{font-size:17px;line-height:1.2;overflow-wrap:anywhere}.folderTitle small,.projectTitle small{font-size:12px;color:#777}.folderArrow,.projectArrow{font-size:20px;color:#777;width:24px;text-align:center}
.archiveFolderBody{background:#f7f7fa;border-top:1px solid #ececf0;padding:8px}.projectCard{background:#fff;border:1px solid #e1e1e6;border-radius:14px;overflow:hidden;margin:8px 0}.projectHead{padding:12px}.projectIconBig{width:32px;height:32px;background:#eaf2ff;color:#0a84ff;font-size:15px}.projectTitle strong{font-size:14px;line-height:1.3;overflow-wrap:anywhere}.projectBody{border-top:1px solid #eee}
.reportRow{display:flex;align-items:center;gap:10px;padding:11px 12px;border-top:1px solid #f0f0f2;background:#fff}.reportRow:first-child{border-top:0}.reportMain{min-width:0;flex:1;display:flex;align-items:center;gap:9px;flex-wrap:wrap}.reportMain strong{font-size:14px}.reportStatus{font-size:11px;font-weight:700;border-radius:999px;padding:5px 8px;white-space:nowrap}.reportStatus.isSigned{background:#e9f7ed;color:#19723a}.reportStatus.isDraft{background:#f0f0f4;color:#666}.openReport{border:1px solid #d5d5da;background:#fff;border-radius:9px;padding:8px 12px;font-weight:600;white-space:nowrap}
@media(max-width:520px){.archiveFolderHead{padding:14px 12px}.reportRow{padding:10px}.reportMain{gap:6px}.reportMain strong{font-size:13px}.openReport{padding:7px 10px}}

/* iPhone-Wischaktionen: Löschbutton liegt versteckt hinter dem Eintrag und wird nur durch einen echten Wisch sichtbar. */
.swipeTarget{position:relative;overflow:hidden;border-radius:inherit;}
.swipeWrap{position:relative;width:100%;overflow:hidden;border-radius:inherit;background:transparent;}
.swipeContent{position:relative;z-index:2;width:100%;background:#fff;transition:transform .22s ease;touch-action:pan-y;will-change:transform;}
.swipeDelete{position:absolute;z-index:1;right:0;top:0;bottom:0;width:104px;margin:0;padding:6px 4px;border:0;border-radius:0;background:transparent;color:#ff3b30;display:none!important;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer;-webkit-tap-highlight-color:transparent;}
.swipeTarget.swipeOpen .swipeDelete{display:flex!important;}
.swipeDeleteIcon{width:72px;height:54px;border-radius:17px;background:#ff3b30;display:grid;place-items:center;box-shadow:0 1px 2px rgba(0,0,0,.08);}
.swipeDeleteIcon svg{width:28px;height:28px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.swipeDeleteLabel{font-size:14px;line-height:18px;font-weight:600;color:#ff3b30;white-space:nowrap;}
.swipeTarget.swipeOpen .swipeContent{box-shadow:0 0 0 1px rgba(255,59,48,.12);}
.archiveFolderHead,.projectHead{user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent;}
@media(max-width:520px){.swipeDelete{width:104px;}.swipeDeleteIcon{width:72px;height:54px;}.swipeDeleteLabel{font-size:14px}.swipeContent{touch-action:pan-y;}}


/* Mitarbeiter und Leistungen: Speichern/Löschen nicht dauerhaft anzeigen. Änderungen werden automatisch gespeichert; Löschen erfolgt per Wischen. */
.serviceRow{position:relative;overflow:hidden;padding:0;margin:8px 0;border-bottom:0;border-radius:12px;background:#fff;}
.serviceRow .swipeWrap{border-radius:12px;}
.serviceRow .swipeContent{background:#fff;padding:0;}
.serviceRow .serviceEdit,.serviceRow .employeeEdit{width:100%;margin:0;border:1px solid #d5d5da;border-radius:12px;padding:12px;background:#fff;font:inherit;}
.serviceRow .swipeDelete{width:104px;}
@media(max-width:520px){.serviceRow{margin:8px 0}.serviceRow .swipeDelete{width:104px}}

/* Elegante Verwaltung von Mitarbeitern und Leistungen */
.manageIntro{display:flex;align-items:center;gap:12px;margin:4px 0 14px;padding:4px 2px}
.manageIcon{width:46px;height:46px;border-radius:14px;background:#eaf2ff;display:grid;place-items:center;font-size:23px}
.manageIntro strong{display:block;font-size:20px;line-height:1.15}
.manageIntro small{display:block;color:#777;font-size:13px;margin-top:3px}
.addBar{display:flex;flex-direction:column;align-items:stretch;gap:10px;background:#fff;border:1px solid #e2e2e7;border-radius:16px;padding:12px;margin-bottom:18px;box-shadow:0 1px 2px rgba(0,0,0,.04)}
.addBar input{width:100%;box-sizing:border-box;border:0!important;background:transparent!important;margin:0!important;padding:12px 4px!important;outline:none;box-shadow:none!important;font-size:17px;min-height:44px}
.addCircle{flex:0 0 44px;width:44px;height:44px;border:0;border-radius:14px;background:#0a84ff;color:#fff;font-size:28px;line-height:1;display:grid;place-items:center}
.listPanel{background:#fff;border-radius:18px;padding:6px 10px 10px;box-shadow:0 1px 3px rgba(0,0,0,.05);border:1px solid #e2e2e7}
.listHeader{padding:8px 6px 10px;border-bottom:1px solid #eee}
.listHeader h2{margin:0;font-size:18px}
.listHeader small{display:block;color:#8a8a8f;font-size:12px;margin-top:3px}
.serviceRow{margin:6px 0!important;border-radius:14px!important;background:#fff!important}
.serviceRow .swipeWrap{border-radius:14px!important}
.serviceRow .swipeContent{border:1px solid #ececf0;border-radius:14px!important;min-height:62px;display:flex;align-items:center;padding:0 12px!important}
.serviceRow .serviceEdit,.serviceRow .employeeEdit{border:0!important;border-radius:0!important;background:transparent!important;padding:12px 8px 12px 4px!important;margin:0!important;font-size:17px!important;outline:none;box-shadow:none!important}
.serviceRow .swipeDelete{width:96px!important}
.serviceRow .swipeDeleteIcon{width:58px!important;height:46px!important;border-radius:15px!important}
.serviceRow .swipeDeleteLabel{font-size:13px!important}
@media(max-width:520px){.screen{padding:14px 16px}.manageIntro{margin-top:2px}.listPanel{padding-left:8px;padding-right:8px}.serviceRow .swipeContent{min-height:60px}.serviceRow .serviceEdit,.serviceRow .employeeEdit{font-size:16px!important}}

/* Verwaltung: kompakter Speichern-Button statt Plus-Symbol */
.saveManage{width:100%;box-sizing:border-box;flex:0 0 auto;border:0;border-radius:12px;background:#0a84ff;color:#fff;padding:13px 18px;font-size:16px;font-weight:700;white-space:nowrap;min-height:52px;}
.saveManage:active{transform:scale(.98)}
@media(max-width:520px){.saveManage{padding:13px 16px;font-size:16px;min-height:52px}.addBar{gap:8px;padding:10px}}

/* Final: kompakte X-Wischaktion für Mitarbeiter und Leistungen */
.swipeDelete{width:72px!important; padding:0!important; background:transparent!important; display:none!important; align-items:center!important; justify-content:center!important;}
.swipeTarget.swipeOpen .swipeDelete{display:flex!important;}
.swipeDeleteIcon{width:48px!important;height:48px!important;border-radius:14px!important;background:#ff3b30!important;color:#fff!important;display:grid!important;place-items:center!important;font-size:34px!important;font-weight:300!important;line-height:1!important;box-shadow:0 1px 3px rgba(0,0,0,.12)!important;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif!important;}
.swipeDeleteLabel{display:none!important;}
.serviceRow .swipeDelete{width:72px!important;}
.serviceRow .swipeDeleteIcon{width:46px!important;height:46px!important;border-radius:14px!important;font-size:32px!important;}
@media(max-width:520px){.swipeDelete{width:72px!important}.serviceRow .swipeDelete{width:72px!important}.swipeDeleteIcon{width:46px!important;height:46px!important}}

/* Finale kompakte Darstellung Verwaltung: Mitarbeiter und Leistungen */
.serviceRow{position:relative!important;display:block!important;height:58px!important;margin:4px 0!important;padding:0!important;border:0!important;border-radius:12px!important;background:transparent!important;overflow:hidden!important}
.serviceRow .swipeWrap{position:relative!important;width:100%!important;height:58px!important;overflow:hidden!important;border-radius:12px!important;background:transparent!important}
.serviceRow .swipeContent{position:relative!important;width:100%!important;height:58px!important;min-height:58px!important;display:flex!important;align-items:center!important;padding:0 10px!important;background:#fff!important;border:1px solid #e4e4e8!important;border-radius:12px!important;box-shadow:none!important;transform:translate3d(0,0,0);transition:transform .18s ease!important}
.serviceRow .serviceEdit,.serviceRow .employeeEdit{flex:1 1 auto!important;width:100%!important;height:56px!important;min-height:56px!important;padding:0 8px!important;margin:0!important;border:0!important;border-radius:11px!important;background:#fff!important;font-size:16px!important;line-height:56px!important;outline:none!important;box-shadow:none!important;color:#111!important}
/* Kein Platzhalter/Block zwischen den Einträgen */
.serviceRow::before,.serviceRow::after,.serviceRow .swipeWrap::before,.serviceRow .swipeWrap::after,.serviceRow .swipeContent::before,.serviceRow .swipeContent::after{content:none!important;display:none!important;background:transparent!important}
/* X nur nach geöffnetem Wisch sichtbar */
.serviceRow .swipeDelete{position:absolute!important;z-index:1!important;right:4px!important;top:4px!important;bottom:4px!important;width:54px!important;height:50px!important;padding:0!important;margin:0!important;border:0!important;border-radius:12px!important;background:transparent!important;display:none!important;opacity:1!important;pointer-events:none!important;align-items:center!important;justify-content:center!important}
.serviceRow.swipeOpen .swipeDelete{display:flex!important;pointer-events:auto!important}
.serviceRow .swipeDeleteIcon{display:grid!important;width:42px!important;height:42px!important;margin:0!important;border-radius:12px!important;background:#ff3b30!important;color:#fff!important;place-items:center!important;font-size:30px!important;font-weight:300!important;line-height:1!important;box-shadow:0 1px 3px rgba(0,0,0,.10)!important}
@media(max-width:520px){
  .listPanel{padding:6px 8px 8px!important}
  .listHeader{padding:8px 6px 8px!important}
  .serviceRow{height:56px!important;margin:3px 0!important}
  .serviceRow .swipeWrap,.serviceRow .swipeContent{height:56px!important;min-height:56px!important}
  .serviceRow .serviceEdit,.serviceRow .employeeEdit{height:54px!important;min-height:54px!important;line-height:54px!important;font-size:16px!important}
  .serviceRow .swipeDelete{width:52px!important;height:48px!important;top:4px!important;bottom:4px!important}
  .serviceRow .swipeDeleteIcon{width:40px!important;height:40px!important;font-size:28px!important;border-radius:11px!important}
}

/* FIX3: Verwaltung ohne Platzhalter/Plus-Felder; X nur beim Wischen */
.serviceActions{display:none!important}
.serviceRow{position:relative!important;display:block!important;height:58px!important;margin:4px 0!important;padding:0!important;border:0!important;border-radius:12px!important;background:transparent!important;overflow:hidden!important}
.serviceRow .swipeWrap{position:relative!important;width:100%!important;height:58px!important;overflow:hidden!important;border-radius:12px!important;background:transparent!important}
.serviceRow .swipeContent{position:relative!important;z-index:2!important;width:100%!important;height:58px!important;display:flex!important;align-items:center!important;padding:0 12px!important;background:#fff!important;border:1px solid #e4e4e8!important;border-radius:12px!important;transform:translate3d(0,0,0);transition:transform .18s ease!important}
.serviceRow .serviceEdit,.serviceRow .employeeEdit{flex:1!important;width:100%!important;height:56px!important;min-height:56px!important;padding:0 8px!important;margin:0!important;border:0!important;border-radius:11px!important;background:#fff!important;font-size:16px!important;line-height:56px!important;outline:none!important;box-shadow:none!important;color:#111!important;-webkit-appearance:none!important;appearance:none!important}
.serviceRow::before,.serviceRow::after,.serviceRow .swipeWrap::before,.serviceRow .swipeWrap::after,.serviceRow .swipeContent::before,.serviceRow .swipeContent::after{content:none!important;display:none!important}
.serviceRow .swipeDelete{position:absolute!important;z-index:1!important;right:5px!important;top:5px!important;width:48px!important;height:48px!important;padding:0!important;margin:0!important;border:0!important;border-radius:14px!important;background:#ff3b30!important;display:none!important;align-items:center!important;justify-content:center!important;pointer-events:none!important}
.serviceRow.swipeOpen .swipeDelete{display:flex!important;pointer-events:auto!important}
.serviceRow .swipeDeleteIcon{display:grid!important;width:48px!important;height:48px!important;margin:0!important;border-radius:14px!important;background:#ff3b30!important;color:#fff!important;place-items:center!important;font-size:30px!important;font-weight:300!important;line-height:1!important}
.swipeDeleteLabel{display:none!important}
.addBar{display:flex!important;align-items:center!important;gap:10px!important}
.addBar input{flex:1!important;min-width:0!important;width:auto!important}
.saveManage{width:100%!important;min-height:52px!important;border-radius:14px!important}
@media(max-width:520px){.serviceRow{height:56px!important;margin:3px 0!important}.serviceRow .swipeWrap,.serviceRow .swipeContent{height:56px!important}.serviceRow .serviceEdit,.serviceRow .employeeEdit{height:54px!important;min-height:54px!important;line-height:54px!important;font-size:16px!important}.serviceRow .swipeDelete{width:48px!important;height:48px!important;top:4px!important;right:4px!important}.serviceRow .swipeDeleteIcon{width:40px!important;height:40px!important;border-radius:12px!important;font-size:28px!important}.addBar{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:10px!important}.saveManage{width:100%!important}}


/* FINAL CLEAN SWIPE UI - Verwaltung */
#serviceList,#employeeList{display:block!important}
#serviceList .serviceRow,#employeeList .serviceRow{
  position:relative!important; display:block!important; width:100%!important;
  height:56px!important; min-height:56px!important; margin:3px 0!important; padding:0!important;
  overflow:hidden!important; border:0!important; background:transparent!important; border-radius:12px!important;
}
#serviceList .serviceRow .swipeWrap,#employeeList .serviceRow .swipeWrap{
  position:relative!important; display:block!important; width:100%!important; height:56px!important;
  margin:0!important; padding:0!important; overflow:hidden!important; background:transparent!important; border:0!important;
}
#serviceList .serviceRow .swipeContent,#employeeList .serviceRow .swipeContent{
  position:relative!important; z-index:2!important; display:flex!important; align-items:center!important;
  width:100%!important; height:56px!important; min-height:56px!important; margin:0!important; padding:0 8px!important;
  background:#fff!important; border:1px solid #e4e4e8!important; border-radius:12px!important;
  box-shadow:none!important; transform:translate3d(0,0,0); transition:transform .18s ease!important;
}
#serviceList .serviceRow .serviceEdit,#serviceList .serviceRow .employeeEdit,
#employeeList .serviceRow .serviceEdit,#employeeList .serviceRow .employeeEdit{
  display:block!important; flex:1 1 auto!important; width:100%!important; height:54px!important;
  margin:0!important; padding:0 8px!important; border:0!important; outline:0!important; box-shadow:none!important;
  background:#fff!important; color:#111!important; border-radius:11px!important; font:inherit!important;
  font-size:16px!important; line-height:54px!important; -webkit-appearance:none!important; appearance:none!important;
}
#serviceList .serviceRow .swipeDelete,#employeeList .serviceRow .swipeDelete{
  position:absolute!important; z-index:1!important; right:4px!important; top:4px!important;
  width:48px!important; height:48px!important; min-width:48px!important; padding:0!important; margin:0!important;
  border:0!important; border-radius:12px!important; background:#ff3b30!important;
  display:flex!important; align-items:center!important; justify-content:center!important;
  visibility:hidden!important; opacity:0!important; pointer-events:none!important;
}
#serviceList .serviceRow.swipeOpen .swipeDelete,#employeeList .serviceRow.swipeOpen .swipeDelete{
  visibility:visible!important; opacity:1!important; pointer-events:auto!important;
}
#serviceList .serviceRow .swipeDeleteIcon,#employeeList .serviceRow .swipeDeleteIcon{
  display:grid!important; place-items:center!important; width:40px!important; height:40px!important;
  margin:0!important; padding:0!important; border:0!important; border-radius:11px!important;
  background:#ff3b30!important; color:#fff!important; font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif!important;
  font-size:28px!important; font-weight:300!important; line-height:40px!important; box-shadow:none!important;
}
#serviceList .serviceRow::before,#serviceList .serviceRow::after,#serviceList .swipeWrap::before,#serviceList .swipeWrap::after,#serviceList .swipeContent::before,#serviceList .swipeContent::after,
#employeeList .serviceRow::before,#employeeList .serviceRow::after,#employeeList .swipeWrap::before,#employeeList .swipeWrap::after,#employeeList .swipeContent::before,#employeeList .swipeContent::after{
  content:none!important; display:none!important; width:0!important; height:0!important; background:none!important;
}
#serviceList .serviceRow + .serviceRow,#employeeList .serviceRow + .serviceRow{margin-top:3px!important}
.addBar{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:8px!important}
.saveManage{width:100%!important;min-height:52px!important}

/* iPhone Safari: prevent automatic focus zoom on form controls */
input, select, textarea, button { font-size: 16px; }
input::placeholder, textarea::placeholder { font-size: 16px; }
html { -webkit-text-size-adjust: 100%; }

/* FIX8: Prevent iPhone Safari auto-zoom on project textarea */
#project { font-size:16px !important; line-height:1.35; }

/* FIX9: iPhone Safari darf beim Fokussieren von Eingabefeldern nicht zoomen. */
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { touch-action: manipulation; }
#project { font-size: 16px !important; -webkit-text-size-adjust: 100%; }


/* Kompaktes Datumsfeld mit deutschem Wochentag */
.dateInputWrap{position:relative;width:100%;margin-top:5px}
#dateDisplay{margin-top:0;width:100%;height:44px;font-size:16px!important;background:#fafafa;cursor:pointer}
.nativeDatePicker{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;border:0!important;opacity:0!important;cursor:pointer!important;z-index:2!important;-webkit-appearance:none!important;appearance:none!important}

/* Uhrzeiten: nur Viertelstunden (00/15/30/45), ohne Safari-Zeitpicker */
.timeSelect{width:100%;margin-top:5px;padding:11px;border:1px solid #d5d5da;border-radius:10px;font:inherit;background:#fafafa;min-height:45px;}
.projectManual{display:block}
#projectSelect{width:100%;margin-top:5px;padding:11px;border:1px solid #d5d5da;border-radius:10px;font:inherit;background:#fafafa;min-height:45px}
#projectList{margin-top:10px}
.projectManageRow{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #eee}
.projectManageRow span{flex:1;font-size:15px}
.projectManageRow button{width:38px;height:38px;border:0;border-radius:10px;background:#fce8e8;color:#d00;font-size:24px;line-height:1}
.hint{color:#777}

/* FIX21: Optimierte Tablet-Darstellung (iPad/Android-Tablet) */
@media (min-width: 521px) and (max-width: 1199px){
  body{padding-bottom:96px;font-size:18px}
  header{padding:20px 30px;min-height:92px}
  header small{font-size:16px}
  h1{font-size:34px;margin:3px 0}
  header button{width:58px;height:58px;font-size:34px}
  .screen{max-width:920px;padding:28px 34px}
  h2{font-size:26px;margin-bottom:18px}
  .title{gap:18px;margin-bottom:4px}
  .title button,#addWork,#addMat,#homeBtn,#clear,.titleBtn{font-size:18px;padding:12px 16px;border-radius:12px}
  .panel{border-radius:20px;padding:24px;margin-bottom:20px}
  label{font-size:17px;margin:16px 0}
  input,select,textarea{font-size:18px!important;padding:15px;border-radius:14px;margin-top:7px}
  textarea{min-height:100px}
  .primary{font-size:19px;padding:17px 20px;border-radius:14px}
  .big{min-height:64px}
  .cards{gap:16px}
  .card{padding:22px;font-size:25px;border-radius:18px;gap:18px}
  .card span{font-size:19px}
  .card small{font-size:15px;margin-top:5px}
  .employee{padding:16px;margin:12px 0;border-radius:15px}
  .grid{gap:12px}
  .steps{font-size:15px;padding:12px;border-radius:12px;margin-bottom:18px}
  .hint{font-size:17px;line-height:1.5}
  .signatureStatus{font-size:16px;padding:13px 15px}
  .summaryBlock{padding:18px;border-radius:16px}
  .summaryBlock h3{font-size:20px}
  .summaryMeta{gap:10px;font-size:17px}
  .summaryMeta div{padding:12px}
  .summaryTable{font-size:16px}
  .summaryTable th{font-size:13px}
  .summaryTable th,.summaryTable td{padding:10px 7px}
  .actions{gap:12px}
  nav{height:88px}
  nav button{font-size:28px;min-width:120px}
  nav small{font-size:14px;margin-top:3px}

  /* Verwaltung: größere, gut mit dem Finger bedienbare Zeilen */
  #serviceList .serviceRow,#employeeList .serviceRow{height:68px;min-height:68px;margin:7px 0}
  #serviceList .serviceRow .swipeWrap,#employeeList .serviceRow .swipeWrap{height:68px}
  #serviceList .serviceRow .swipeContent,#employeeList .serviceRow .swipeContent{height:68px;min-height:68px;padding:0 14px;border-radius:14px}
  #serviceList .serviceRow .serviceEdit,#serviceList .serviceRow .employeeEdit,
  #employeeList .serviceRow .serviceEdit,#employeeList .serviceRow .employeeEdit{
    height:66px;font-size:19px!important;line-height:66px;padding:0 12px
  }
  #serviceList .serviceRow .swipeDelete,#employeeList .serviceRow .swipeDelete{right:6px;top:6px;width:56px;height:56px}
  #serviceList .serviceRow .swipeDeleteIcon,#employeeList .serviceRow .swipeDeleteIcon{width:46px;height:46px;font-size:31px;border-radius:13px}

  /* Neue Tagelohn-Einträge */
  .employee .row{gap:12px}
  .row{gap:12px}
  canvas{height:240px}
  .dateInputWrap{margin-top:7px}
  #dateDisplay,#projectSelect{height:54px;min-height:54px;font-size:18px!important}
  .timeSelect{min-height:54px;font-size:18px!important}
}

/* FIX22: Mehr Abstand zwischen den Verwaltungsfeldern auf Tablets */
@media (min-width: 521px){
  #serviceList .serviceRow,#employeeList .serviceRow{
    margin:0 0 12px 0!important;
  }
  #serviceList .serviceRow + .serviceRow,#employeeList .serviceRow + .serviceRow{
    margin-top:0!important;
  }
}

/* FIX23: Einheitliche einzelne Felder in Mitarbeiter-/Leistungsverwaltung
   Die Felder bleiben bewusst getrennt, erhalten aber einen vollständigen,
   sauberen Rahmen und gleichmäßigen Abstand. */
#serviceList,#employeeList{display:flex!important;flex-direction:column!important;gap:14px!important;padding:0!important}
#serviceList .serviceRow,#employeeList .serviceRow{
  box-sizing:border-box!important;
  width:100%!important;
  height:68px!important;
  min-height:68px!important;
  margin:0!important;
  padding:0!important;
  overflow:hidden!important;
  border:0!important;
  background:transparent!important;
  border-radius:14px!important;
}
#serviceList .serviceRow .swipeWrap,#employeeList .serviceRow .swipeWrap{
  box-sizing:border-box!important;
  width:100%!important;
  height:68px!important;
  margin:0!important;
  padding:0!important;
  overflow:hidden!important;
  border:0!important;
  border-radius:14px!important;
  background:transparent!important;
}
#serviceList .serviceRow .swipeContent,#employeeList .serviceRow .swipeContent{
  box-sizing:border-box!important;
  width:100%!important;
  height:68px!important;
  min-height:68px!important;
  margin:0!important;
  padding:0 14px!important;
  border:1px solid #dfe0e5!important;
  border-radius:14px!important;
  background:#fff!important;
  overflow:hidden!important;
}
#serviceList .serviceRow .serviceEdit,#serviceList .serviceRow .employeeEdit,
#employeeList .serviceRow .serviceEdit,#employeeList .serviceRow .employeeEdit{
  box-sizing:border-box!important;
  width:100%!important;
  height:66px!important;
  min-height:66px!important;
  margin:0!important;
  padding:0 10px!important;
  border:0!important;
  border-radius:13px!important;
  background:#fff!important;
  font-size:19px!important;
  line-height:66px!important;
}
#serviceList .serviceRow + .serviceRow,#employeeList .serviceRow + .serviceRow{margin-top:0!important}

@media(max-width:520px){
  #serviceList,#employeeList{gap:10px!important}
  #serviceList .serviceRow,#employeeList .serviceRow,
  #serviceList .serviceRow .swipeWrap,#employeeList .serviceRow .swipeWrap{height:56px!important;min-height:56px!important}
  #serviceList .serviceRow .swipeContent,#employeeList .serviceRow .swipeContent{height:56px!important;min-height:56px!important;border-radius:12px!important;padding:0 10px!important}
  #serviceList .serviceRow .serviceEdit,#serviceList .serviceRow .employeeEdit,
  #employeeList .serviceRow .serviceEdit,#employeeList .serviceRow .employeeEdit{height:54px!important;min-height:54px!important;line-height:54px!important;font-size:16px!important;border-radius:11px!important}
}

/* FIX26: Untere Navigation auf iPad/iPhone wirklich am sichtbaren Bildschirm fixieren */
html,body{width:100%;min-height:100%;overflow-x:hidden}
body{padding-bottom:calc(70px + env(safe-area-inset-bottom))}
nav{
  position:fixed!important;
  left:0!important;
  right:0!important;
  bottom:0!important;
  top:auto!important;
  width:100%!important;
  height:calc(70px + env(safe-area-inset-bottom))!important;
  padding-bottom:env(safe-area-inset-bottom)!important;
  box-sizing:border-box!important;
  z-index:9999!important;
  background:rgba(255,255,255,.98)!important;
  -webkit-transform:translateZ(0)!important;
  transform:translateZ(0)!important;
  -webkit-backface-visibility:hidden!important;
  backface-visibility:hidden!important;
}
@media (min-width:521px) and (max-width:1199px){
  body{padding-bottom:calc(88px + env(safe-area-inset-bottom))!important}
  nav{
    height:calc(88px + env(safe-area-inset-bottom))!important;
    padding-bottom:env(safe-area-inset-bottom)!important;
  }
}
